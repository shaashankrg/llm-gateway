# Base URL of the deployed FastAPI gateway. No trailing slash.
# Leave unset locally to see the "demo offline" state.
NEXT_PUBLIC_GATEWAY_URL=https://your-gateway.fly.dev

# Optional. Sent as the X-Demo-Token header on every /demo/* call.
# NOTE: NEXT_PUBLIC_* vars ship to the browser — this is a throttle, not a secret.
NEXT_PUBLIC_DEMO_TOKEN=
